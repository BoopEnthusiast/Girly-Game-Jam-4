[sub_resource type="GDScript" id="GDScript_27fem"]
script/source = "extends Sprite2D



func _ready() -> void:
	get_viewport().size_changed.connect(_change_position)
	_change_position()



func _change_position() -> void:
	global_position = get_viewport_rect().get_center()
"

